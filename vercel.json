{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "test -f public/NOTICE.txt && test ! -e public/v1",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/v1/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
